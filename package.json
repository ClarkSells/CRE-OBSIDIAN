{
  "name": "strive-navigator-obsidian",
  "version": "2.0.0",
  "private": true,
  "description": "DFW commercial real estate investment-sales intelligence for Obsidian",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "load-smoke": "node scripts/load-smoke.cjs",
    "test:v2": "node scripts/test-v2.mjs",
    "benchmark": "node scripts/benchmark-25k.mjs",
    "verify": "node scripts/verify.mjs",
    "acceptance": "npm run build && npm run typecheck && npm run load-smoke && npm run test:v2 && npm run benchmark && npm run install:sample && npm run verify",
    "install:sample": "node scripts/install-sample.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.5",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3",
    "@types/sql.js": "^1.4.9"
  },
  "dependencies": {
    "cytoscape": "^3.33.1",
    "maplibre-gl": "^5.6.2",
    "pmtiles": "^4.3.0",
    "sql.js": "^1.13.0"
  }
}
